# The public product works without any LLM key.
# Optional semantic fallback: used only when deterministic retrieval cannot
# understand the question. It never writes the political answer.
LLM_RETRIEVAL_FALLBACK_ENABLED=true
LLM_FALLBACK_API_KEY=
# OPENAI_API_KEY=  # accepted alternative
# LLM_API_KEY=     # legacy compatibility only; prefer a dedicated fallback key
LLM_FALLBACK_API_URL=https://api.openai.com/v1/chat/completions
LLM_FALLBACK_MODEL=gpt-5-nano
LLM_FALLBACK_TIMEOUT_MS=5500

NEXT_PUBLIC_REPOSITORY_URL=https://github.com/TFourniax/programmes-politiques-france-2027
