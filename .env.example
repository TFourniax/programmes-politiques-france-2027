LLM_API_KEY=
# OPENAI_API_KEY=  # alternative accepted by the retrieval fallback
LLM_API_URL=https://api.openai.com/v1/chat/completions
LLM_MODEL=gpt-5-mini
LLM_TIMEOUT_MS=15000

# Optional semantic fallback. It is only used when deterministic retrieval cannot
# understand the question; it never writes the political answer.
LLM_RETRIEVAL_FALLBACK_ENABLED=true
LLM_FALLBACK_MODEL=gpt-5-mini
LLM_FALLBACK_TIMEOUT_MS=5500

NEXT_PUBLIC_REPOSITORY_URL=https://github.com/TFourniax/programmes-politiques-france-2027
